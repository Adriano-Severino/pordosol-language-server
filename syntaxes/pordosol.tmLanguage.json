{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Por Do Sol",
    "scopeName": "source.pordosol",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#interpolated-strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#classes"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#namespaces"
        },
        {
            "include": "#members"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.pordosol",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.pordosol",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control",
                    "match": "\\b(se|então|senão|enquanto|para|função|retorne|imprima|novo|este)\\b"
                },
                {
                    "name": "storage.type.class",
                    "match": "\\b(classe|interface)\\b"
                },
                {
                    "name": "keyword.other.using",
                    "match": "\\b(espaco|usando|classe|construtor|var|interface)\\b"
                },
                {
                    "name": "storage.modifier",
                    "match": "\\b(publico|privado|protegido|estática|sobrescreve|redefinível|abstrata)\\b"
                },
                {
                    "name": "constant.language.boolean",
                    "match": "\\b(verdadeiro|falso)\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type",
                    "match": "\\b(inteiro|texto|booleano|vazio|duplo|flutuante|decimal)\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.assignment",
                    "match": "="
                },
                {
                    "name": "keyword.operator.comparison",
                    "match": "(==|!=|<=|>=|<|>)"
                },
                {
                    "name": "keyword.operator.arithmetic",
                    "match": "(\\+|\\-|\\*|/|%)"
                },
                {
                    "name": "keyword.operator.logical",
                    "match": "(&&|\\|\\||!)"
                },
                {
                    "name": "punctuation.accessor",
                    "match": "\\."
                },
                {
                    "name": "punctuation.separator.inheritance",
                    "match": ":"
                },
                {
                    "name": "storage.type.function.arrow",
                    "match": "=>"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape",
                    "match": "\\\\."
                }
            ]
        },
        "interpolated-strings": {
            "name": "string.interpolated",
            "begin": "\\$\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "meta.interpolation",
                    "begin": "\\{",
                    "end": "\\}",
                    "patterns": [
                        {
                            "include": "$self"
                        }
                    ]
                },
                {
                    "name": "constant.character.escape",
                    "match": "\\\\."
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float",
                    "match": "\\b((?:[0-9]+\\.[0-9]*|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?|[0-9]+\\.[0-9]*[eE][+-]?[0-9]+)\\b"
                },
                {
                    "name": "constant.numeric.integer",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "classes": {
            "patterns": [
                {
                    "name": "entity.name.type",
                    "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function",
                    "match": "\\b[A-Za-zÀ-ÿ_][A-Za-zÀ-ÿ0-9_]*(?=\\s*\\())"
                }
            ]
        },
        "namespaces": {
            "patterns": [
                {
                    "name": "entity.name.namespace",
                    "match": "(?<=espaco\\s+)\\b[A-Z][a-zA-Z0-9_]*\\b"
                }
            ]
        },
        "members": {
            "patterns": [
                {
                    "name": "variable.other.member",
                    "match": "(?<=\\.)([A-Za-zÀ-ÿ_][A-Za-zÀ-ÿ0-9_]*)"
                },
                {
                    "name": "entity.name.function.constructor",
                    "match": "(?<=construtor\\s)\\b[A-Z][a-zA-Z0-9_]*\\b"
                }
            ]
        }
    }
}